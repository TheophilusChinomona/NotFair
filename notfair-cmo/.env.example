# ── Database ────────────────────────────────────────────────────────
# Postgres (Docker/prod). Omit to use local SQLite at ~/.notfair-cmo/db.sqlite.
DATABASE_URL=postgres://user:pass@host:5432/notfair_cmo

# ── Auth ────────────────────────────────────────────────────────────
# REQUIRED in production. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the deployed app (https://...). Used for auth callbacks + trusted origins.
BETTER_AUTH_URL=http://localhost:3326
# ── Base URL for MCP resource URLs ──────────────────────────────────
# Overrides MCP endpoint base for production. Falls back to:
# 1. NEXT_PUBLIC_BETTER_AUTH_URL
# 2. http://localhost:3326 (local dev)
NEXT_PUBLIC_MCP_BASE_URL=

# ── Google Ads MCP ──────────────────────────────────────────────────
# REQUIRED for Google Ads tools. Get from Google Ads UI > Tools > API Center.
# Application takes ~24h to approve.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Your Google Ads manager/MCC account ID (optional, for multi-account setups).
# Format: 123-456-7890 (with dashes)
GOOGLE_ADS_MANAGER_ID=

# Default customer ID to operate on (optional, overridable per call).
# Format: 1234567890 (digits only) or 123-456-7890
GOOGLE_ADS_CUSTOMER_ID=

# ── Meta Ads MCP ────────────────────────────────────────────────────
# REQUIRED for Meta Ads tools. Generate from:
# https://developers.facebook.com/tools/explorer/
# Scopes needed: ads_management, ads_read, business_management
META_ACCESS_TOKEN=

# ── Google API Access (GSC + GBP + Google Ads) ─────────────────────
# Google Application Default Credentials (ADC) path.
# If unset, falls back to gcloud CLI default credentials.
# For production, use a service account JSON key.
# Scopes needed:
#   GSC:  webmasters, webmasters.readonly
#   GBP:  business.manage
#   Ads:  adwords
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# Alternatively, set individual fields for a service account:
# GSC_CLIENT_EMAIL=your-sa@project.iam.gserviceaccount.com
# GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

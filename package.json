{
  "name": "norfair",
  "version": "0.5.5.14",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "pnpm": ">=10",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "scripts": {
    "preinstall": "node -e \"if (!(process.env.npm_config_user_agent || '').startsWith('pnpm')) { console.error('\\n\\u26d4  This project uses pnpm. Run \\u0060pnpm install\\u0060 instead. See README for setup.\\n'); process.exit(1); }\"",
    "dev": "next dev",
    "build": "pnpm run typecheck && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run __tests__/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:backfill-operation-user-ids": "npx tsx scripts/backfill-operation-user-ids.ts",
    "db:backfill-google-connections": "npx tsx scripts/backfill-google-connections.ts",
    "db:check-google-connection-invariant": "npx tsx scripts/check-google-connection-invariant.ts",
    "db:refresh-stale-account-snapshots": "tsx scripts/refresh-stale-account-snapshots.ts",
    "db:apply-0040-gohighlevel": "npx tsx scripts/apply-migration-0040-gohighlevel.ts",
    "db:apply-0041-gohighlevel-oauth": "npx tsx scripts/apply-migration-0041-gohighlevel-oauth.ts",
    "db:apply-0045-mcp-tool-feedback": "tsx scripts/apply-migration-0045-mcp-tool-feedback.ts",
    "db:apply-0046-campaign-benchmarks": "tsx scripts/apply-migration-0046-campaign-benchmark-snapshots.ts",
    "db:apply-0051-google-account-health": "tsx scripts/apply-migration-0051-google-account-health.ts",
    "db:backfill-campaign-benchmarks": "tsx scripts/backfill-campaign-benchmark-snapshots.ts",
    "db:monthly-campaign-benchmark-budget": "tsx scripts/backfill-campaign-benchmark-snapshots.ts --mode=traffic --credit-budget=500 --max-accounts=5000 --concurrency=1 --days=30 --allow-errors",
    "db:reclassify-campaign-benchmark-niches": "tsx scripts/reclassify-campaign-benchmark-niches.ts",
    "db:enrich-campaign-benchmark-domain-metadata": "tsx scripts/enrich-campaign-benchmark-domain-metadata.ts",
    "db:enrich-campaign-benchmark-landing-pages": "tsx scripts/enrich-campaign-benchmark-landing-pages.ts",
    "eval:mcp": "npx tsx scripts/eval-mcp/eval.ts",
    "eval:mcp:compare": "npx tsx scripts/eval-mcp/compare.ts",
    "mcp-feedback:triage": "tsx scripts/triage-mcp-feedback.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/google": "^3.0.29",
    "@ai-sdk/openai": "^3.0.48",
    "@ai-sdk/react": "^3.0.140",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@jitl/quickjs-wasmfile-release-asyncify": "^0.32.0",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "acorn": "^8.16.0",
    "ai": "^6.0.85",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.29.2",
    "google-ads-api": "^22.0.0",
    "googleapis": "^170.1.0",
    "lucide-react": "^0.563.0",
    "mcp-handler": "^1.1.0",
    "next": "16.1.6",
    "next-intl": "^4.11.0",
    "outrank-next-js-blog": "0.1.1",
    "postgres": "^3.4.8",
    "posthog-js": "^1.364.7",
    "posthog-node": "^5.28.11",
    "quickjs-emscripten": "^0.32.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "resend": "^6.10.0",
    "sanitize-html": "^2.17.3",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "stripe": "^22.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.53.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.1"
  }
}
